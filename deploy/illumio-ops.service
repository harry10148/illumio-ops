[Unit]
Description=Illumio PCE Operations Monitor
Documentation=https://github.com/illumio-ops/illumio-ops
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=illumio-ops
Group=illumio-ops
WorkingDirectory=/opt/illumio-ops
# ProtectHome=true already hides /home, but say it outright: the bundled
# interpreter must never read the host's user site-packages.
Environment=PYTHONNOUSERSITE=1
ExecStart=/opt/illumio-ops/python/bin/python3 /opt/illumio-ops/illumio-ops.py --monitor-gui --interval 10
# always 而非 on-failure：長駐服務任何非預期的結束（包含以 0 結束）都應重啟；
# systemctl stop 不會觸發重啟。
Restart=always
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
SyslogIdentifier=illumio-ops
# Files this service creates (config.json backups, the cache, state, reports,
# logs) hold PCE data and credentials; without this they were 0644 and any
# local account could read them. Group keeps read access for log shippers
# added to the illumio-ops group.
UMask=0027

# --- Hardening ---
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
# MemoryDenyWriteExecute intentionally omitted: CPython 3.12 memory allocator
# uses mprotect(PROT_WRITE|PROT_EXEC) during thread init on RHEL/Rocky 9,
# causing "can't start new thread" failures under this restriction.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/opt/illumio-ops/logs /opt/illumio-ops/config /opt/illumio-ops/data /opt/illumio-ops/reports

[Install]
WantedBy=multi-user.target
